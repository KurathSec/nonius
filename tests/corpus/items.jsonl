{"family": "aggregate", "id": "sum-a", "payload": {"op": "sum", "prompt": "Sum the list [1, 2, 3].", "values": [1, 2, 3]}, "results": [{"name": "total", "tag": "int"}]}
{"family": "aggregate", "id": "sum-b", "payload": {"op": "sum", "prompt": "Sum the list [10, 20].", "values": [10, 20]}, "results": [{"name": "total", "tag": "int"}]}
{"family": "threshold", "id": "thr-live", "payload": {"cut": 10, "hi": "high", "lo": "low", "op": "threshold", "prompt": "Report high if {subject} >= 10, otherwise low.", "subject": 4}, "results": [{"codomain": ["high", "low"], "name": "verdict", "tag": "str"}], "slots": [{"consumer": "threshold", "name": "subject", "tag": "int"}]}
{"family": "threshold", "id": "thr-dead", "payload": {"cut": -99999, "hi": "high", "lo": "low", "op": "threshold", "prompt": "Report high if {subject} >= -99999, otherwise low.", "subject": 4}, "results": [{"codomain": ["high", "low"], "name": "verdict", "tag": "str"}], "slots": [{"consumer": "threshold", "name": "subject", "tag": "int"}]}
{"family": "threshold", "id": "dual-a", "payload": {"cut": 10, "hi": "high", "lo": "low", "op": "dual", "prompt": "Report high for each of {subject_a} and {subject_b} that is >= 10, else low.", "subject_a": 0, "subject_b": 0}, "results": [{"codomain": ["high", "low"], "name": "verdict_a", "tag": "str"}, {"codomain": ["high", "low"], "name": "verdict_b", "tag": "str"}], "slots": [{"consumer": "dual", "name": "subject_a", "tag": "int"}, {"consumer": "dual", "name": "subject_b", "tag": "int"}]}
{"family": "route", "id": "lk-live", "payload": {"default": "unknown", "key": "low", "op": "lookup", "prompt": "Look {key} up in the table high->escalate, low->ignore; default unknown.", "table": {"high": "escalate", "low": "ignore"}}, "results": [{"codomain": ["escalate", "ignore", "unknown"], "name": "route", "tag": "str"}], "slots": [{"consumer": "lookup", "name": "key", "tag": "str"}]}
{"family": "route", "id": "lk-miss", "payload": {"default": "unknown", "key": "alpha", "op": "lookup", "prompt": "Look {key} up in the table alpha->x, beta->y; default unknown.", "table": {"alpha": "x", "beta": "y"}}, "results": [{"codomain": ["x", "y", "unknown"], "name": "route", "tag": "str"}], "slots": [{"consumer": "lookup", "name": "key", "tag": "str"}]}
{"family": "route", "id": "lk-nocodomain", "payload": {"default": "unknown", "key": "low", "op": "lookup", "prompt": "Look {key} up in the table high->escalate, low->ignore; default unknown.", "table": {"high": "escalate", "low": "ignore"}}, "results": [{"name": "route", "tag": "str"}], "slots": [{"consumer": "lookup", "name": "key", "tag": "str"}]}
{"family": "membership", "id": "mem-a", "payload": {"op": "member", "pool": [1, 2, 3], "probe": 2, "prompt": "Is {probe} in [1, 2, 3]?"}, "results": [{"codomain": [false, true], "name": "present", "tag": "bool"}], "slots": [{"consumer": "member", "name": "probe", "tag": "int"}]}
{"family": "excluded", "id": "float-item", "payload": {"cut": 10, "hi": "high", "lo": "low", "op": "threshold", "prompt": "Report high if {subject} >= 10, otherwise low.", "subject": 4}, "results": [{"codomain": ["high", "low"], "name": "verdict", "tag": "str"}], "slots": [{"consumer": "threshold", "name": "subject", "tag": "float"}]}
